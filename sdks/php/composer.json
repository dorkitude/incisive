{
    "name": "dorkitude/incisive",
    "description": "PHP client for the Incisive self-hosted analytics API (event ingestion, queries, scoped keys)",
    "type": "library",
    "license": "MIT",
    "keywords": ["incisive", "analytics", "events"],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Incisive\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Incisive\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
