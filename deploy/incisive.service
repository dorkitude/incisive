[Unit]
Description=Incisive analytics server
After=network-online.target
Wants=network-online.target

[Service]
User=incisive
ExecStart=/usr/local/bin/incisive --config /etc/incisive/incisive.toml serve
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
